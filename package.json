{
  "name": "lantern",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Lantern — an independent knowledge base and study hub.",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "vite",
    "server": "node server/bootstrap.js",
    "start": "node server/bootstrap.js",
    "build": "vite build",
    "preview": "vite preview",
    "typecheck": "tsc -p tsconfig.app.json --noEmit --pretty false && tsc -p tsconfig.node.json --noEmit --pretty false",
    "lint": "eslint . --max-warnings 0",
    "test": "node --test",
    "test:backend": "node --test test/backend/*.test.js",
    "import:legacy": "node scripts/legacy-import.mjs",
    "reconcile": "node scripts/reconcile.mjs",
    "backup": "node scripts/recovery.mjs backup",
    "backup:verify": "node scripts/recovery.mjs verify",
    "restore:verify": "node scripts/recovery.mjs restore-verify",
    "check": "npm run typecheck && npm run lint && npm test && npm run build"
  },
  "dependencies": {
    "@azure/msal-browser": "^4.25.0",
    "@azure/msal-react": "^3.0.20",
    "@emotion/react": "^11.14.0",
    "@emotion/styled": "^11.14.1",
    "@mui/icons-material": "^7.3.4",
    "@mui/material": "^7.3.4",
    "better-sqlite3": "^11.10.0",
    "dotenv": "^17.3.1",
    "express": "^5.1.0",
    "jose": "^6.2.4",
    "mermaid": "^11.15.0",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "react-router-dom": "^7.9.5"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@types/better-sqlite3": "^7.6.13",
    "@types/express": "^5.0.3",
    "@types/node": "^24.6.0",
    "@types/react": "^19.1.16",
    "@types/react-dom": "^19.1.9",
    "@vitejs/plugin-react": "^5.2.0",
    "eslint": "^9.39.5",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-react-refresh": "^0.4.22",
    "globals": "^16.4.0",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.67.0",
    "vite": "^7.3.6"
  }
}
