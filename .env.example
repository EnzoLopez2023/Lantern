# Local Vite fallback configuration. Production uses /runtime-config.js.
VITE_AZURE_AD_CLIENT_ID=
VITE_AZURE_AD_TENANT_ID=
VITE_AZURE_AD_API_SCOPE=
VITE_ALLOW_DEV_AUTH=false
VITE_DEV_AUTH_TENANT_ID=00000000-0000-4000-8000-000000000000
VITE_DEV_AUTH_OID=00000000-0000-4000-8000-000000000001

# Server Entra configuration
AZURE_AD_CLIENT_ID=
AZURE_AD_TENANT_ID=
AZURE_AD_AUDIENCE=
AZURE_AD_API_SCOPE=
AZURE_AD_DELEGATED_SCOPE=access_as_user
ALLOW_DEV_AUTH=false
DEV_AUTH_OID=00000000-0000-4000-8000-000000000001
DEV_AUTH_TENANT_ID=00000000-0000-4000-8000-000000000000
LANTERN_BOOTSTRAP_ADMIN_TENANT_ID=
LANTERN_BOOTSTRAP_ADMIN_OID=

# Runtime
NODE_ENV=development
PORT=3001
DB_PATH=./data/lantern.db
LANTERN_DB_ALLOW_CREATE=false
SQLITE_BUSY_TIMEOUT_MS=5000
SHUTDOWN_DRAIN_TIMEOUT_MS=45000

# Azure Speech
AZURE_SPEECH_KEY=
AZURE_SPEECH_REGION=eastus
AZURE_SPEECH_VOICE=en-US-JennyNeural
AZURE_SPEECH_TIMEOUT_MS=15000
AZURE_SPEECH_STREAM_IDLE_TIMEOUT_MS=10000
AZURE_SPEECH_STREAM_TIMEOUT_MS=120000

# Recovery
BACKUP_ROOT=./backups
